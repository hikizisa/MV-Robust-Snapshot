<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MapsetVerifier.Plugin.CustomSnapshots</AssemblyName>
    <HostAssemblyDirectory Condition="'$(HostAssemblyDirectory)' == ''">$(MSBuildProjectDirectory)/lib</HostAssemblyDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="MV-Robust-Snapshot.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>MV-Robust-Snapshot.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(HostAssemblyDirectory)/MapsetVerifier.Framework.dll" />
    <Reference Include="$(HostAssemblyDirectory)/MapsetVerifier.Snapshots.dll" />
    <Reference Include="$(HostAssemblyDirectory)/MapsetVerifier.Parser.dll" />
    <Reference Include="$(HostAssemblyDirectory)/MapsetVerifier.Logging.dll" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="Serilog" Version="4.3.1" />
  </ItemGroup>

  <Target Name="CopyToCustomChecks" AfterTargets="Build" Condition="'$(DeployPlugin)' == 'true' and '$(SkipCustomChecksCopy)' != 'true' and '$(APPDATA)' != ''">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(APPDATA)\Mapset Verifier Externals\CustomChecks" />
  </Target>
</Project>
